# Copy to .env.local for local work; the same list is what Vercel needs, minus
# the dev-only flag at the bottom. Every one of these is server-side — nothing
# here is NEXT_PUBLIC, so none of it reaches the browser. Keep it that way.

# --- Supabase -------------------------------------------------------------
# URL and anon key are also what the auth middleware uses to read the session.
# The service-role key bypasses row-level security and can read the `accounts`
# table, which stores live passwords and tokens. Server-only, always.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Who may sign in ------------------------------------------------------
# Comma-separated, compared lower-cased. Checked in three places: before a
# magic link is sent, in the middleware on every request, and again in every
# /api route. Someone with a valid Supabase session but no entry here still
# gets nothing.
ALLOWED_EMAILS=
# The reviewers (PF-26): who may open the Sessions page, where Yurie's recorded
# posting sessions are read. Same shape as ALLOWED_EMAILS; must also be in it.
# Anyone else gets the not-found page. Set in the Production row on Vercel.
REVIEWER_EMAILS=

# --- n8n ------------------------------------------------------------------
N8N_BASE_URL=https://czed.app.n8n.cloud
N8N_API_KEY=
# Post-Ban retire flow. Without both of these the retire action returns 503
# rather than failing silently, which is deliberate.
N8N_POSTBAN_WEBHOOK_URL=
N8N_POSTBAN_WEBHOOK_SECRET=

# --- The warmup script on the Air (PF-13) -----------------------------------
# Opens /api/warmup-runner/* and nothing else. A long random string; the Air
# holds the same value. Unset means those addresses answer 503, never open.
# Generate one with: openssl rand -hex 32
WARMUP_RUNNER_TOKEN=

# --- The phone-farm production sheet ----------------------------------------
# Opens /api/sheet-inventory (stock counts) and nothing else. The sheet's Apps
# Script holds the same value. Unset means 503, never open.
# Generate one with: openssl rand -hex 32
SHEET_INVENTORY_TOKEN=

# --- The live view on the Air (PF-14) ---------------------------------------
# The Air's address for the live view page:
# https://yuries-macbook-air-1.tail85d8ff.ts.net (the Air, 100.85.112.50;
# Garreth and Czedrick, 2026-10-01). Not secret: it shows in the page as the
# Live view link, and only answers inside Tailscale. Unset means the Live view
# buttons stay drawn but inert. It must be https for the dashboard to check that the Air is
# there before offering the link; an http address is offered unchecked.
LIVE_VIEW_URL=

# --- Vendor APIs ----------------------------------------------------------
GEELARK_BEARER_TOKEN=
PROXYCHEAP_API_KEY=
PROXYCHEAP_API_SECRET=
TEXTVERIFIED_API_KEY=
TEXTVERIFIED_API_USERNAME=
SCRAPECREATORS_API_KEY=

# Query embeddings for direct Supabase carousel search, the Carousel
# Generator's writer, and Claude's read of a recorded posting session (PF-26).
# Server-only.
OPENROUTER_API_KEY=
# The model that reads a session's frames. Optional; the default is the writer's.
PHONE_SESSION_REVIEW_MODEL=

# The AI watermark remover (SynthID Study, hosted on Modal), which the
# Carousel Generator's AI edit calls before its degrade pass. Server-only.
SYNTHID_API_KEY=
# Optional: override the remover's address. Defaults to the Modal URL.
SYNTHID_API_URL=

# Higgsfield's developer API, which the Carousel Generator's Generate images
# calls (DEV-30). The complete key copied from open.higgsfield.ai, pasted as
# it is (KEY_ID:KEY_SECRET). It is a separate balance from the higgsfield.ai
# subscription. Server-only.
HIGGSFIELD_API_KEY=
# Optional: override the API address. Defaults to https://api.higgsfield.ai.
HIGGSFIELD_API_URL=
# Optional: the model Tag with AI reads pictures with (through OpenRouter).
# Defaults to the writer's model.
CAROUSEL_VISION_MODEL=

# --- Dev only. NEVER set this in Vercel -----------------------------------
# Disables the auth gate entirely. Guarded by NODE_ENV !== "production" as a
# second line of defence, but do not rely on that — just leave it unset.
AUTH_BYPASS=

# The daily copy of reference pictures into our own storage. Any long random
# string; Vercel's scheduler sends it by itself once it is set.
CRON_SECRET=
