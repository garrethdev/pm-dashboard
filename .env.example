# Copy to .env.local for local work; the same list is what Vercel needs, minus
# the dev-only flag at the bottom. Every one of these is server-side — nothing
# here is NEXT_PUBLIC, so none of it reaches the browser. Keep it that way.

# --- Supabase -------------------------------------------------------------
# URL and anon key are also what the auth middleware uses to read the session.
# The service-role key bypasses row-level security and can read the `accounts`
# table, which stores live passwords and tokens. Server-only, always.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Who may sign in ------------------------------------------------------
# Comma-separated, compared lower-cased. Checked in three places: before a
# magic link is sent, in the middleware on every request, and again in every
# /api route. Someone with a valid Supabase session but no entry here still
# gets nothing.
ALLOWED_EMAILS=

# --- n8n ------------------------------------------------------------------
N8N_BASE_URL=https://czed.app.n8n.cloud
N8N_API_KEY=
# Post-Ban retire flow. Without both of these the retire action returns 503
# rather than failing silently, which is deliberate.
N8N_POSTBAN_WEBHOOK_URL=
N8N_POSTBAN_WEBHOOK_SECRET=

# --- Vendor APIs ----------------------------------------------------------
GEELARK_BEARER_TOKEN=
PROXYCHEAP_API_KEY=
PROXYCHEAP_API_SECRET=
TEXTVERIFIED_API_KEY=
TEXTVERIFIED_API_USERNAME=
SCRAPECREATORS_API_KEY=

# Query embeddings for direct Supabase carousel search. Server-only.
OPENROUTER_API_KEY=

# --- Dev only. NEVER set this in Vercel -----------------------------------
# Disables the auth gate entirely. Guarded by NODE_ENV !== "production" as a
# second line of defence, but do not rely on that — just leave it unset.
AUTH_BYPASS=
